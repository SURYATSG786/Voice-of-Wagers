{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/",
      "destination": "/welcome/index.html"
    },
    {
      "source": "/welcome/(.*)",
      "destination": "/welcome/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
